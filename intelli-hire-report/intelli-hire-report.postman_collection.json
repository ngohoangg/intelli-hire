          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('reportId', jsonData.data.id);",
                  "    pm.collectionVariables.set('sessionId', jsonData.data.session_id);",
                  "}",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has report data', function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('total_score');",
                  "    pm.expect(jsonData.data).to.have.property('skill_scores');",
                  "    pm.expect(jsonData.data).to.have.property('question_scores');",
                  "});"
