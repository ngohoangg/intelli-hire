          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Name",
                "value": "grading-service"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"session-001\",\n  \"user_id\": 1,\n  \"topic\": \"Backend Java\",\n  \"summary\": \"Ứng viên có kiến thức tốt về Java Core và Spring Boot. Cần cải thiện thêm về Database Optimization và System Design.\",\n  \"roadmap_json\": {\n    \"recommendations\": [\n      {\n        \"skill\": \"Database Optimization\",\n        \"priority\": \"HIGH\",\n        \"resources\": [\"SQL Performance Explained\", \"Use The Index, Luke\"]\n      },\n      {\n        \"skill\": \"System Design\",\n        \"priority\": \"MEDIUM\",\n        \"resources\": [\"Designing Data-Intensive Applications\", \"System Design Interview\"]\n      }\n    ],\n    \"next_focus\": \"Database Optimization\",\n    \"estimated_improvement_weeks\": 4\n  },\n  \"question_scores\": [\n    {\n      \"question_id\": \"q-001\",\n      \"question_text\": \"Explain the difference between ArrayList and LinkedList in Java\",\n      \"answer_text\": \"ArrayList uses dynamic array internally, provides O(1) random access but O(n) insertion. LinkedList uses doubly-linked list, O(1) insertion but O(n) access.\",\n      \"score\": 8.5,\n      \"max_score\": 10,\n      \"feedback\": \"Good explanation of time complexity differences. Could mention memory overhead of LinkedList nodes.\",\n      \"skill_name\": \"Java Core\"\n    },\n    {\n      \"question_id\": \"q-002\",\n      \"question_text\": \"What is Spring Boot Auto-Configuration?\",\n      \"answer_text\": \"Spring Boot auto-configuration automatically configures Spring application based on jar dependencies. It uses @EnableAutoConfiguration and conditional annotations.\",\n      \"score\": 9.0,\n      \"max_score\": 10,\n      \"feedback\": \"Excellent answer covering the key concepts. Good mention of conditional annotations.\",\n      \"skill_name\": \"Spring Boot\"\n    },\n    {\n      \"question_id\": \"q-003\",\n      \"question_text\": \"How would you optimize a slow SQL query?\",\n      \"answer_text\": \"I would check the execution plan, add appropriate indexes, and consider query restructuring.\",\n      \"score\": 5.0,\n      \"max_score\": 10,\n      \"feedback\": \"Basic answer. Missing details about EXPLAIN ANALYZE, covering indexes, query caching, and denormalization strategies.\",\n      \"skill_name\": \"Database\"\n    },\n    {\n      \"question_id\": \"q-004\",\n      \"question_text\": \"Explain the SOLID principles\",\n      \"answer_text\": \"SOLID stands for Single Responsibility, Open-Closed, Liskov Substitution, Interface Segregation, and Dependency Inversion. Each class should have one reason to change.\",\n      \"score\": 7.0,\n      \"max_score\": 10,\n      \"feedback\": \"Correctly listed all principles but only explained SRP in detail. Should elaborate on each with examples.\",\n      \"skill_name\": \"Java Core\"\n    },\n    {\n      \"question_id\": \"q-005\",\n      \"question_text\": \"Design a URL shortener system\",\n      \"answer_text\": \"Use a hash function to generate short codes, store mapping in database, redirect on access.\",\n      \"score\": 4.5,\n      \"max_score\": 10,\n      \"feedback\": \"Very high-level answer. Missing discussion of: base62 encoding, collision handling, caching layer, analytics, scalability considerations.\",\n      \"skill_name\": \"System Design\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reports",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reports"]
            }
          }
        },
