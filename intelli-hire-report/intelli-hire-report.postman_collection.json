              "raw": "{\n  \"session_id\": \"session-002\",\n  \"user_id\": 1,\n  \"topic\": \"Backend Java\",\n  \"summary\": \"Buổi phỏng vấn lần 2. Ứng viên đã cải thiện về Database nhưng vẫn cần luyện thêm System Design.\",\n  \"roadmap_json\": {\n    \"recommendations\": [\n      {\n        \"skill\": \"System Design\",\n        \"priority\": \"HIGH\",\n        \"resources\": [\"System Design Interview Vol 2\"]\n      }\n    ],\n    \"next_focus\": \"System Design\",\n    \"estimated_improvement_weeks\": 3\n  },\n  \"question_scores\": [\n    {\n      \"question_id\": \"q-006\",\n      \"question_text\": \"What is the difference between HashMap and ConcurrentHashMap?\",\n      \"answer_text\": \"HashMap is not thread-safe while ConcurrentHashMap uses segment locking for thread safety with better performance than synchronized HashMap.\",\n      \"score\": 8.0,\n      \"max_score\": 10,\n      \"feedback\": \"Good understanding of concurrency concepts.\",\n      \"skill_name\": \"Java Core\"\n    },\n    {\n      \"question_id\": \"q-007\",\n      \"question_text\": \"Explain database indexing and when to use composite indexes\",\n      \"answer_text\": \"Indexes are B-tree structures for fast lookups. Composite indexes follow leftmost prefix rule. Use when queries filter on multiple columns frequently.\",\n      \"score\": 7.5,\n      \"max_score\": 10,\n      \"feedback\": \"Much improved from last session. Good mention of B-tree and leftmost prefix.\",\n      \"skill_name\": \"Database\"\n    },\n    {\n      \"question_id\": \"q-008\",\n      \"question_text\": \"Design a notification system\",\n      \"answer_text\": \"Use message queue like Kafka, with different channels (email, push, SMS). Store notification preferences per user.\",\n      \"score\": 5.5,\n      \"max_score\": 10,\n      \"feedback\": \"Better than previous system design answer but still missing details on retry mechanism, rate limiting, and template system.\",\n      \"skill_name\": \"System Design\"\n    }\n  ]\n}"
